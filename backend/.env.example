PORT=3001
# Postgres: Neon en produccion; en local, `docker compose up -d` en la raiz del repo
DATABASE_URL=postgresql://pachamapa:pachamapa@localhost:5433/pachamapa
# Origenes permitidos para CORS, separados por coma (vacio = todos)
CORS_ORIGIN=
# Opcional: clasifica el texto libre de los reportes. Sin clave se usa un clasificador por palabras clave.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL_ASISTENTE=llama-3.3-70b-versatile
# Opcional: alertas por WhatsApp con Twilio. Sin estas tres variables los mensajes solo se escriben en el log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero de WhatsApp de Twilio (sandbox: +14155238886)
TWILIO_WHATSAPP_FROM=
# Opcional: URL publica del backend (para el enlace de baja; en Render se detecta sola) y del frontend (enlace al mapa)
PUBLIC_URL=
FRONTEND_URL=
# Opcional: horas que pasan antes de repetir el aviso de un tramo que sigue igual (por defecto 6)
ALERTAS_REPETIR_HORAS=
# Opcional: noticias de los diarios sobre las rutas (Google Noticias). NOTICIAS=no las desactiva.
NOTICIAS=
# Cada cuantos minutos se consultan (por defecto 5) y de cuantas horas para atras (por defecto 48)
NOTICIAS_MINUTOS=
NOTICIAS_HORAS=
# Opcional: servidor de rutas OSRM para los viajes por la Argentina (por defecto el publico de demostracion)
OSRM_URL=
