generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reporte {
  id         String   @id @default(cuid())
  tipo       String
  tramoId    String   @map("tramo_id")
  comentario String?
  canal      String   @default("web")
  creadoEn   DateTime @default(now()) @map("creado_en")
  expiraEn   DateTime @map("expira_en")

  @@index([expiraEn])
  @@map("reportes")
}

model Visita {
  id        Int      @id @default(autoincrement())
  visitante String?
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@index([visitante])
  @@map("visitas")
}

model Interesado {
  id       Int      @id @default(autoincrement())
  nombre   String
  contacto String
  rubro    String
  mensaje  String?
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("lista_espera")
}

model Suscripcion {
  id        String   @id @default(cuid())
  telefono  String   @unique
  nombre    String?
  // Vacio = todos los tramos
  tramos    String[]
  // Estado minimo que dispara el aviso: "atencion" o "problemas"
  nivel     String   @default("problemas")
  // Franja horaria (hora de Jujuy) en la que se avisa; iguales = a toda hora
  desdeHora Int      @default(0) @map("desde_hora")
  hastaHora Int      @default(0) @map("hasta_hora")
  activo    Boolean  @default(true)
  token     String   @unique
  creadoEn  DateTime @default(now()) @map("creado_en")
  alertas   AlertaEnviada[]

  @@map("suscripciones")
}

model AlertaEnviada {
  id            Int         @id @default(autoincrement())
  suscripcionId String      @map("suscripcion_id")
  suscripcion   Suscripcion @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  // Id de la alerta que lo disparo (clave de la situacion)
  clave         String
  tramoId       String      @map("tramo_id")
  estado        String
  motivos       String
  enviadoEn     DateTime    @default(now()) @map("enviado_en")

  @@index([enviadoEn])
  @@map("alertas_enviadas")
}
